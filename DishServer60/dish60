def getCommands(az, el):
    global first_detected_error

    while(True):

        # Make client address None so it's false.
        client_address = None
        # Create a socket object (AF_INET = IPv4, SOCK_STREAM = TCP)
        server_socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        server_socket.setblocking(True)

        # Bind to '' (allows connections from any IP) and a port

        server_socket.bind(('', DishSocket))

        server_socket.listen(1)

        logging.debug("Server is waiting for a connection...")

        # Wait for a connection
        (client_socket, client_address) = server_socket.accept()
        client_socket.setblocking(True)
                
        logging.info(f"Connected to: {client_address}")

        Dish.POWER_ON()

        while (True):

            # Block waiting for a command to come in
            command = client_socket.recv(1024).decode().strip().upper()

            logging.debug(f'COMMAND: {command}')

            # If it's an exit command, we break the communicantion channel and
            # start waiting for someone else to contact us.
            if (command == "EXIT"):
                break

            splitUp = command.split()
            if (len(splitUp)):
                #
                # We have some command to parse, parse it.
                #
                results = parseCommand(az, el, splitUp)
            else:
                #
                # Blank line, just return nothing back (keepalive method?)
                #
                results = ""

            #Find the command
            for re_expression, dispatch in commands.items():
                args = re_expression.match(command)
                if (args):
                    results = dispatch(args)
                    break
            else:
                results = "ERROR: Command or command syntax not recognised"

            if (results == "DISCONNECT"):
                logging.debug("DISCONNECT command received")
                break
        
            if (results == "EXIT"):
                break

            logging.info(f'RESULTS: {results}')
            
            # Send data, if you can't send, disconnect
            try:
                client_socket.send(results.encode())
            except BrokenPipeError:
                break

        #We're exiting, power off the dish
        Dish.POWER_OFF()

        #Seems the only way to cleanly close the socket is to try a send first.
        # Just ignore any errors.
        try:
            client_socket.send(''.encode())
        except:
            pass

        client_socket.close()

        server_socket.shutdown(socket.SHUT_RDWR)
        server_socket.close();

        logging.debug(f"Connnection with {client_address} closed")

        if (command == "EXIT"):
            text = "EXIT command received, exiting dish server"
            logging.info(text)
            EMERGENCY_STOP(text)
            # Return to top-level of server program
            return
        self.progress = 1

################################################################################
################################################################################
#
# The main code. Set everything up and kick off the threads/processes here.
#
################################################################################
################################################################################

def main():
    global VFDrelay, AZenable, ELup, ELdown, first_detected_error

    #
    # Initialize I2C synchronization lock
    #
    i2cLock = threading.Lock()

    VFDrelay = RELAY("VFD", VFD_RELAY)

    #
    # DAC initialization comes first so when the relays are tested the DAC voltages
    # are at zero so nothing happens during the relay test (on and off).
    #


    #
    # The azimuth motor is made up of the DAC and enable relay.
    #
    AZenable = RELAY("Azimuth enable", AZ_RELAY)
    AZmotor = MOTOR_CONTROL_COPLEY(Encoder(AzimuthEncoder(ENCODER_NR25("Azimuth",
                                                                        ENCODER_AZIMUTH_IP,
                                                                        ENCODER_AZIMUTH_PORT,
                                                                        AZIMUTH_ADJUSTMENT)),
                                           AZIMUTH_MINIMUM,
                                           AZIMUTH_MAXIMUM,
                                           AZIMUTH_EXCURSION_ERROR),
                                   DAC_GP8630N("Azimuth",
                                                GP8630N_AZIMUTH_I2C,
                                                i2cLock),
                                   AZenable)

    #
    # Now that the DAC is set to zero voltage, test the azimuth relay
    #
    AZenable.test()

    #
    # The elevation motor is made up of the DAC and enable up and down relays
    #
    ELup = RELAY("Elevation up", ELUP_RELAY)
    ELdown = RELAY("Elevation down", ELDN_RELAY)
    ELmotor = MOTOR_CONTROL_ALLEN_BRADLEY(Encoder(ElevationEncoder(ENCODER_NR25("Elevation",
                                                                                 ENCODER_ELEVATION_IP,
                                                                                 ENCODER_ELEVATION_PORT,
                                                                                 ELEVATION_ADJUSTMENT)),
                                                  ELEVATION_MINIMUM,
                                                  ELEVATION_MAXIMUM,
                                                  ELEVATION_EXCURSION_ERROR),
                                          DAC_GP8630N("Elevation",
                                                       GP8630N_ELEVATION_I2C,
                                                       i2cLock),
                                          ELup,
                                          ELdown)

    #
    # Now that the DAC is set to zero voltage, test the elevation relays
    #
    ELup.test()
    ELdown.test()

    #
    # If we had any errors during initialization severe enough to set the abort
    # flag, don't start anything at this point!
    #
    if (first_detected_error):
        text = "Errors detected during initialization, aborting run"
        logging.critical(text)
        EMERGENCY_STOP(text)
        exit(1)

    #
    # Create Azimuth work queue and start thread
    #
    AZprogress = Progress("Azimuth")
    AZthread = threading.Thread(target=AxisControl, args=(AZmotor,))
    AZthread.start()

    #
    # Create Elevation work queue and start thread
    #
    ELthread = threading.Thread(target=AxisControl, args=(ELmotor, ))
    ELthread.start()

    #
    # Start work input command queue
    #
    CMDthread = threading.Thread(target=getCommands, args=(AZmotor, ELmotor))
    CMDthread.start()

    logging.info("Setup of DSES 60 foot dish complete")

    #DishData = gdefs.DataFile(Path(__file__).name + '.dat')

    #
    # Monitor thread prgress and abort if hung
    #
    monitor = (AZprogress. ELprogress, CMDprogress)
    last_progress = [0] * len(monitor)

    while (not first_detected_error):
        #
        # Allow the other threads to run most of the time
        #
        sleep(10)

        for _ in range(len(monitor)):
            progress = monitor[_].progress
            if (progress == last_progress[i]):
                #
                # A process is hung, kill everything. This will set the abort flag
                # and get us out of the while loop.
                #
                text = f'{monitor[_].name} is hung'
                logging.critical(text)
                EMERGENCY_STOP(text)
                break

            #
            # We made progress, update the progress
            #
            last_progress[i] = progress

    #
    # Something crashed, wait for all processes to exit
    #
    AZthread.join()
    ELthread.join()
    CMDthread.join()

if (__name__ == "__main__"):
    main()

exit(0)