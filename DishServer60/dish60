def axisInfo(motor):

    #
    # +1 and -1 are printed as they are, 0 becomes " 0" to avoid "+0" for
    # asthetics but keeping the field width the same.
    #
    current_direction = motor.currentDirection()
    current_direction = f'{current_direction():+2d}' if current_direction else " 0"

    return(f'OK {motor.encoder.position():+08.3f} {current_direction} {motor.ETA():03d} {motor.destination:+08.3f} {motor.encoder.minimum:+08.3f} {motor.encoder.maximum:+08.3f}')

movePos = re.compile(r'(\+{1,2})$')
moveNeg = re.compile(r'(-{1,2})$')
moveDegrees = re.compile(r'([\+-]?\d{1,3}|[\+-]?\d{1,3}\.\d{0,3}|[\+-]?\d{0,2}\.\d{1,3})$')

def moveDegrees(motor, position, speed_limit=None):

    #
    # Not using the speed limit yet
    #

    position = float(position) # Valid because the string was screened by the RE
    if (position < motor.encoder.minimum):
        return(f"Error: Invalid position specified, minimum is {motor.encoder.minimum}")
    if (position > motor.encoder.maximum):
        return(f"Error: Invalid position specified, maximum is {motor.encoder.maximum}")

    #
    # Queue the work to start the axis moving and wait until you can see the
    # dish actually moving which means the axisInfo call will return something
    # accurate!
    #
    AxisControlWait(motor, position)

    #
    # Now return information about the axis
    #
    return (axisInfo(ELmotor))

def moveManual(motor, speed):

    #
    # Determine direction and speed
    #
    if (speed[0] == "+"):
        #
        # It's a "+", move up to the maximum degrees or until stopped
        #
        return(movDegrees(motor, motor.encoder.maximum, len(speed)))
    
    #
    # If not "+", it's minus, move up to the minimum degrees or until stopped
    #
    return(movDegrees(motor, motor.encoder.minimum, len(speed)))

moveManualRE = re.compile(r'(-{1,2}|\+{1,2})$')
moveDegreesRE = re.compile(r'([\+-]?\d{1,3}|[\+-]?\d{1,3}\.\d{0,3}|[\+-]?\d{0,2}\.\d{1,3})$')

moveParse = {
    moveManualRE : moveManual,
    movDegreesRE : moveDegrees
}

def CMDaxis(motor, token):

    if (len(token) > 1):
        #
        # Only zero or one tokens can be supplied to the AZIMUTH command
        #
        return (f'Error: Too many arguments specifed to the "{motor.name.upper()}" command')

    if (not token):
        #
        # Blank axis command - return the current axis position and motion.
        #
        return (axisInfo(motor))

    #
    # We have one token, get rid of the list.
    #
    token = token[0]

    if (token == "STOP"[:len(token)]):
        #
        # Stop detected, stop the axis and wait for the dish to come to a stop
        # before returning the axisInfo to make it valid.
        #
        AxisControlWait(motor, STOP)
        return (axisInfo(motor))

    #
    # Now go looking for a match for the axis command argument
    #
    for regEx, dispatch in moveParse.items():
        match = regEx.match(token)
        if (match):
            return(motor, dispatch(match.group(1)))

    #
    # We should always find a match in the above for loop. If not, we have a
    # command syntax error.
    #
    return (f"Error: Unrecognized argument to "{motor.name.upper()}" command")

def CMDhelp(az, el, token):
    return(HELP_TEXT)

def CMDstop(az, el, token):
    global AZmotor, ELmotor
    #
    # Stop both azimuth and elevation axes
    #
    ELmotor.queue.put((STOP, None))
    AZmotor.queue.put((STOP, None))

    #
    # Because we're not returning any information, we don't have to wait for the
    # command to start, just put it in the queues and return "OK".
    #
    return("OK")


commands = {
    "AZIMUTH" : CMDaxis,
    "ELEVATION" : CMDaxis,
    "HELP" : CMDhelp,
    STOP : CMDstop,
    "?" : CMDhelp
}

def parseCommand(az, el, cmd):

    dispatchList = list()
    for command, dispatch in commands.items():
        #
        # Try and match abbreviated commands to as many commands as possible
        #
        if (cmd[0] == command[:len(cmd[0])]):
            #
            # This command was a match, save it in the dispatch list
            #
            dispatchList.append(dispatch)
            full_command = command

    if (not dispatchList):
        #
        # No command matched
        #
        return(f'Error: "{cmd[0]}" command not found. Try "HELP"')

    if (len(dispatchList) > 1):
        #
        # More than one command matched
        #
        return(f'Error: "{cmd[0]}" ambiguous command, specify more letters. Try "HELP" or "?"')
    
    #
    # One command matched, dispatch to its parsing routine with the rest of the
    # arguments, if any. Once complete, return the text returned from it.
    #
    if (full_command == "AZIMUTH"):
        #
        # It's an azimuth command, call the movement distaptch fucntion with
        # the azimuth motor
        #
        return(dispatch[0](az, cmd[1:]))
    elif (full_command == "ELEVATION"):
        #
        # It's an elevation command, call the movement distaptch fucntion with
        # the elevation motor
        #
        return(dispatch[0](el, cmd[1:]))
    
    #
    # Not an AZIMUTH or ELEVATION command, dispatch to the command
    #
    return(dispatch[0](az, el, cmd[1:]))

