def AxisControl(motor):
    global first_detected_error

    logging.info(f'{motor.name} AxisControl thread starting')

    #
    # Initilize destination as to wherever we are at the moment. get_position()
    # reads the encoder and returns the current value.
    #
    destination = motor.encoder.get_position()

    #
    # Start out by monitoring every 5 seconds
    #
    poll_interval = 5

    #
    # Run as long as we're not aborting
    #
    while (not first_detected_error):
        try:
            #
            # Blocks for a short time to keep from banging on the encoder, then
            # sees if there's work to be done.
            #
            (work, callback) = motor.queue.get(block=True, timeout=poll_interval)
            logging.info(f'{motor.name} work received: {work}')

        except queue.Empty:
            work = None
        
        if (first_detected_error):
            #
            # Critical error encountered while waiting on queue, return
            #
            logging.critical(f'Abort detected, {motor.name} AxisControl thread exiting')
            if (callback):
                #
                # If there's a callback routine, call it.
                callback()
            return
        #
        # Here's our special call to get_position which will cause us to get the
        # current position of the antenna from the encoder ONCE, then that
        # position will be used for all other refeences to the antenna's
        # position.
        #
        # This is to reduce banging on the encoder too much.
        #
        # See if progress is in the same direction as the motor speed.
        #
        motor.encoder.get_position()
        progress = motor.encoder.progress()
        currentDirection = motor.currentDirection()
        if (progress != currentDirection):
            #
            # Big problem, movement isn't matching what we're trying to do!
            # Slam on the brakes.
            #
            EMERGENCY_STOP()
            #
            # We either moving when we should be stopped, stopped when we should
            # be moving or we're moving in the wrong direction. Determine which
            # problem it is, report and abort!
            #
            if (currentDirection):
                #
                # We either not moving or moving in the opposite direction we
                # should be, report
                #
                if (progress):
                    #
                    # We're moving in the wrong direction
                    #
                    text = f'{motor.name} should be moving in a {display_movement(currentDirection)} direction, but moving in a {display_movement(progress)} direction'
                    logging.critical(text)
                else:
                    #
                    # We're not moving but we should be
                    #
                    text = f'{motor.name} should be moving in a {display_movement(currentDirection)} direction, but not moving'
                    logging.critical(text)
            else:
                #
                # We're moving when we should be stopped
                #
                text = f'{motor.name} should not be moving, but it is moving in a {display_movement(currentDirection)} direction'
                logging.critical(text)
            
            #
            # This continue will jump us to the bottom of the loop, at which
            # point the abort flag should be set and we'll exit the routine.
            #
            EMERGENCY_STOP(text)
            continue

        #
        # Everything is hunky-dory, let's see if we have work to do. If we just
        # times out then work is None, which is False.
        #
        if (work):
            #
            # Work to do, see if it's STOP work or a new destination
            #
            if (work == STOP):
                #
                # Set destination to the current position, which will cause
                # setDestination to determine that we've arrived at our
                # destination and stop the dish.
                #
                motor.setDestination(motor.encoder.position())

                #
                # Make the destination EXACTLY what the last encoder
                # position was to assure we don't move anymore.
                #
                destination = motor.encoder.position()
            else:
                #
                # The only other work is a new destination, set it
                #
                destination = work
                motor.setDestination(destination)
            
            #
            # We've either stopped the dish or we've started it on its way
            # to the destination. Call the callback routine to signal our
            # work is done.
            #
            if (callback):
                callback()

        #
        # No work to do, or we started work. Just set the destination again to
        # see if we need to slow down or stop. The poll_interval returned will
        # detemine just how long we can sleep (a long time if stopped), a short
        # time if we're "feathering in" on the destination.
        #
        # Set the correct motor speed and get the next polling interval, then
        # go back and wait for new work for the polling interval time.
        #
        poll_interval = motor.setDestination(destination)

    logging.critical(f'Abort detected, {motor.name} AxisControl thread exiting')
    
    #
    # Critical error encountered while waiting on queue, return
    #
    logging.critical(f'Abort detected, {motor.name} AxisControl thread exiting')
    if (callback):
        #
        # If there's a callback routine, call it.
        callback()


def AxisControlWait(motor, work):

    #
    # Setup event flag
    #
    commandStarted = threading.Event()

    def callback():
        #
        # Signal event flag to unblock this function
        #
        commandStarted.set()

    #
    # Queue the work and wait for it to start
    #
    motor.queue.put((work, callback))
    commandStarted.wait()

    #
    # Return to calling program
    #


def EMERGENCY_STOP(text=None):

    global first_detected_error, VFDrelay, AZenable, ELup, ELdown

    logging.critical("EMERGENCY_STOP called, aborting all threads.")
    #
    # Just kill power to the dish by disabling the VFD.
    #
    # Setting optional debounce time to zero will cause the relay NOT to be
    # checked for correct state, skipping the debounce time. This will allow us
    # to open the all the relays in as little time as possible.
    #
    if (VFDrelay):
        VFDrelay.off(0)

    #
    # Now turn off all motion control relays to stop the dish as quckly as
    # possible. Elevation first since it has nearby physical stops it can run
    # into.
    #
    # Setting optional debounce time to zero will cause the relay NOT to be
    # checked for correct state, skipping the debounce time. This will allow us
    # to open the all the relays in as little time as possible.
    #
    if (ELup):
        ELup.off(0)
    if (ELdown):
        ELdown.off(0)
    
    if (AZenable):
        AZenable.off(0)

    #
    # Now save (only) the first error text reported to EMERGENCY_STOP because
    # that will be the root error that caused all the other (possible) calls to
    # EMERGENCY_STOP
    #
    if (text and (not first_detected_error)):
        first_detected_error = text

def POWER_ON():
    global AZmotor, ELmotor
    
    #
    # Queue "STOP" work to both axis
    #
    AxisControlWait(ELmotor, STOP)
    AxisControlWait(AZmotor, STOP)

    # Allow everything to stop and settle down, then turn on the power
    sleep(5)
    VFDrelay.close()

def POWER_OFF():
    global AZmotor, ELmotor
    
    #
    # Queue "STOP" work to both axis
    #
    AxisControlWait(ELmotor, STOP)
    AxisControlWait(AZmotor, STOP)

    # Now power everything off
    VFDrelay.open()

