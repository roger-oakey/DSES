class MOTOR_CONTROL_GENERIC():

    def currentDirection(self):
        return(sign(self.last_speed))

    def _motorSpeed(self, speed):

        if (speed == self.last_speed):
            #
            # No speed change, nothing to do.
            #
            return

        if (not speed):
            #
            # Speed requested is zero. Stop the motor
            #
            # Turn off the relay(s)
            #
            self._off()

            #
            # The [speed + self.max_speed] converts the speed, for example -2,
            # -1, 0, 1 or 2 to an index range starting at 0.
            #
            self.DAC.voltage(self.voltages[speed + self.max_speed])
        else:
            #
            # We're setting a new speed, make sure it's a valid one first.
            #
            if (abs(speed) > self.max_speed):
                #
                # We requested a speed over the maximum number of requested speeds
                #
                text = f'{self.name} motor, speed {speed} requested, but speed range is (+-){self.max_speed}'
                logging.critical(text)
                EMERGENCY_STOP(text)
                return

            if (reverse(self.last_speed, speed)):
                #
                # If we're reversing, stop first
                #
                self._motorSpeed(0)

            #
            # Convert speed into a voltage and pass to the DAC
            #
            # The [speed + self.max_speed] converts the speed, for example -2, -1,
            # 1 or 2 to an index range starting at 0.
            #
            self.DAC.voltage(self.voltages[speed + self.max_speed])

            #
            # Turn relay on to start the dish moving
            #
            self._on(speed)
        
        #
        # Save the speed you just set as the last_speed
        #
        self.last_speed = speed
        
        #
        # Now wait around for a limited time to see the new direction just set
        # is reflected in the actual movement as reported by the encoders. To
        # "debounce" you must get two in a row in the correct direction.
        # 
        # In other words, wait around here until the physical world of moving
        # the dish catches up with this computer...
        #
        # Get the current, real position
        #
        self.encoder.get_position()
        sameDirectionTwoInARow = False
        for _ in range(0, self.startAttempts):
            #
            # Short delay each time around the loop
            #
            time.sleep(self.startPollDelay)

            #
            # Update the real position
            #
            self.encoder.get_position()
            progress = self.encoder.progress()
            if (sign(speed) == progress):
                #
                # We have movement in the correct direction, see if this is two
                # in a row...
                #
                if (sameDirectionTwoInARow):
                    return
                sameDirectionTwoInARow = True
            else:
                sameDirectionTwoInARow = False
            
        #
        # We fell through the wait loop which means that movement isn't matching
        # what we're trying to do! Slam on the brakes.
        #
        EMERGENCY_STOP()
        #
        # We either moving when we should be stopped, stopped when we should
        # be moving or we're moving in the wrong direction. Determine which
        # problem it is, report and abort!
        #
        if (speed):
            #
            # We either not moving or moving in the opposite direction we
            # should be, report
            #
            if (progress):
                #
                # We're moving in the wrong direction
                #
                text = f"""{motor.name} after speed change should be moving in a {display_movement(speed)} direction,
but moving in a {display_movement(progress)} direction"""
                logging.critical(text)
            else:
                #
                # We're not moving but we should be
                #
                text = f'{motor.name} after speed change should be moving in a {display_movement(speed)} direction, but not moving'
                logging.critical(text)
        else:
            #
            # We're moving when we should be stopped
            #
            text = f'{motor.name} after stop should not be moving, but it is moving in a {display_movement(progress)} direction'
            logging.critical(text)

        #
        # Abort everythin with a good error message.
        #
        EMERGENCY_STOP(text)

    def setDestination(self, destination):

        #
        #Save destination
        #
        self.destination = destination
        degrees = destination - self.encoder.position()
        #
        # Given distance in degrees, compute the speed to move that many
        # dergrees
        #
        for speed in range(self.max_speed):
            if (abs(degrees) <= self.shiftPoints[speed]):
                #
                # Distance is less than this speed's shift distance, exit the
                # loop with this speed determined.
                #
                break
        else:
            #
            # Set speed to maximum
            #
            speed = self.max_speed
        
        #
        # Move at the computed speed
        #
        self._motorSpeed(speed * sign(degrees))
        return (self.pollDelay[speed])

    def ETA(self):
        #
        # If motor stopped, ETA is zero
        #
        if (not self.last_speed):
            return(0)
    
        #
        # Find out how much time to destination at top speed by dividing its
        # rate in degrees/second into the number of degrees you're away from
        # the destination, then add in the feather down time (which includes a
        # round up to the next second). Change to integer and return.
        #
        return (int((abs(destination - self.encoder.position()) / self.rates[-1]) + self.featherTime))

    def __init__(self, encoder, DAC, startTime, rates, shiftPoints, pollDelay):
        self.encoder = encoder
        self.name = self.encoder.name
        self.DAC = DAC
        self.startTime = startTime
        self.rates = rates
        self.shiftPoints = shiftPoints
        self.pollDelay = pollDelay
        self.progress = 1

        #
        # Initialize the work queue for this motor.
        #
        self.work = queue.Queue()

        #
        # Build positive and negative slew rates from the short list
        #
        # Changes rates of (.1, 1) to (-1.0, -0.1, 0, .1, 1.0) for example
        self.rates = []
        for _ in reversed(rates):
            self.rates.append(-_)
        self.rates.append(0.0)
        for _ in rates:
            self.rates.append(_)
        
        #
        # Change to tuple to assure it's not changed and for a little gain in
        # access speed
        #
        self.rates = tuple(self.rates)

        #
        # The maximum absolute speed that we can move (0 - n). Determined by the
        # number of slew rates supplied.
        #
        self.max_speed = len(rates)

        #
        # Now figure out the "feather down" time - the maximum amount of time
        # we'll spend slowing down to less-than-maximum-speed and stopping.
        #
        self.featherTime = 0
        for _ in range(self.max_speed - 1):
            self.featherTime += shiftPoints[ _ + 1] / rates[_]
        #
        # Add in another secondd to integer up.
        #
        self.featherTime += 1.0

        #
        # From the rates, compute the voltages to get those rates.
        #
        tvolts = list()
        for rate in self.rates:
            tvolts.append(self._rate2volts(rate))

        #
        # Save as an immutable Tuple
        #
        if (simulator):
            self.voltages = (0, 1, 2, 3) # Slew rates in voltage for simulator
        else:
            self.voltages = tuple(tvolts) # Slew rates in voltages

        logging.info(f"""{self.name} MOTOR_CONTROL class initializing:
 startTime = {self.startTime} second
 rates = {self.rates} per second
 voltages = {self.voltages} (correspond to rates)
 shiftPoints = {self.shiftPoints} degrees away from destination
 pollDelay = {self.pollDelay}""")

        #
        # Compute the delay time for detecting movement starting or stopping
        #
        self.startPollDelay = self.pollDelay[1]

        #
        # Compute the number of retries waiting for movement to start or stop.
        # We'll try this many times with a delay of startPollDelay in between
        # and hopefully get two progress indicators in the desired direction
        # (-1, 0 or +1).
        #
        self.startAttempts = int((self.startTime / self.pollDelay[1]) + 0.5)

        #
        # We don't want the speed to be zero, but we do a compare before we set
        # last_speed, so set it to something wild that will assure the != 0 will
        # be true.
        #
        self.last_speed = 100

        #
        # Alaways stop when initialized and make the destination the same as the
        # current encoder position.
        #
        self.destination = self.encoder.get_position()
        self._motorSpeed(0)

