def CMDazimuth(token):
    global AZmotor, AZqueue

    if (len(token) > 1):
        #
        # Only zero or one tokens can be supplied to the AZIMUTH command
        #
        return ('Error: Too many arguments specifed to the "AZIMUTH" command')

    if (not token):
        #
        # There is nothing but the "AZIMUTH" command - return the current
        # azimuth and motion.
        #
        return (axisInfo(AZmotor, 0))

    #
    # We have one token, get rid of the list.
    #
    token = token[0]

    if (token == "STOP"[:len(token)]):
        #
        # Stop detected
        #
        AZqueue.put(STOP)
        return (axisInfo(AZmotor))

    #
    # Now go looking for a match for the azimuth command argument
    #
    for regEx, dispatch in azParse.items():
        match = regEx.match(token)
        if (match):
            return(dispatch(match.group(1)))

    #
    # We should always find a match in the above for loop. If not, we have a
    # command syntax error.
    #
    return ("Error: Unrecognized argument to AZIMUTH command")

