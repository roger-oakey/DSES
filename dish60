class MOTOR_CONTROL_ALLEN_BRADLEY(MOTOR_CONTROL_GENERIC):
    #
    # Control of the Elevation via the Allen Bradley motor controller
    #
    def _rate2volts(self, rate):
        if (not rate):
            return(0)
        
        #
        # Different rates for + and - directions
        #
        if (rate > 0):
            return((14.368 * rate) - 0.806)
        return((-14.597 * rate) - 0.868)

    def _off(self):
            #
            # Turn both relays off, but turn the active relay off first since
            # there's a debounce delay in operating the relays, and you want to
            # turn off the active relay as quickly as possible!
            #
            if (self.last_speed > 0):
                self.UPenable.off()
                self.DNenable.off()
            else:
                self.DNenable.off()
                self.UPenable.off()

    def _on(self, speed):
        
        if (speed > 0):
            self.UPenable.on()
        else:
            self.DNenable.on()

    
    def __init__(self, encoder, DAC, enable_up, enable_down):

        #
        # Save the pointers to the Allen Bradley relays
        #
        self.UPenable = enable_up # AB up movement relay
        self.DNenable = enable_down # AB down movement relay

        #
        # Initialize the parent class with the stuff that can be handled
        # generically
        #
        super().__init__(self,
                         encoder,
                         DAC,
                         ALLEN_BRADLEY_STOP_TIME,
                         ALLEN_BRADLEY_SLEW_RATES,
                         ALLEN_BRADLEY_SHIFT_DISTANCES,
                         ALLEN_BRADLEY_POLL_TIMES)
        

