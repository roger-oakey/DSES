    # report valid information
    #
    axis_moving = threading.Event()

    #
    # Queue the work to start the axis moving
    #
    AZqueue.put((azimuth, axis_moving))

    #
    # Block until the axis is moving.
    #
    axis_moving.wait()

    #
    # Now return information about the axis
    #
    return (axisInfo(AZmotor))

