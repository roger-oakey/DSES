class RELAY:
    
    def state(self):
        #
        # Get the status of the pin. It has been set up for negative logic, so
        # with the relay closed it's grounded and "True" and if the relay's open
        # it's pulled high and False.
        #
        status = self.sense.is_active
        logging.debug(f"{self.name} relay state {"ON" if status else "OFF"}")
        return(status)

    def off(self, debounce=RELAY_SETTLE):
        logging.debug(f"{self.name} relay turning OFF")
        self.coil.off()
        if (debounce):
            #
            # If we're verifying that the relay operated correctly, wait for the
            # contacts to settle, then check.
            #
            sleep(debounce)
            if (self.state()):
                text = f"{self.name} relay falied to turn OFF"
                logging.critical(text)
                EMERGENCY_STOP(text)

    def on(self, debounce=RELAY_SETTLE):
        logging.debug(f"{self.name} relay turning ON")
        self.coil.on()
        if (debounce):
            #
            # If we're verifying that the relay operated correctly, wait for the
            # contacts to settle, then check.
            #
            sleep(debounce)
            if (not self.state()):
                text = f"{self.name} relay falied to turn ON"
                logging.critical(text)
                EMERGENCY_STOP(text)

    def test(self):
        logging.debug(f"{self.name} relay test")

        #
        # Always leave the relay in the same state it was before testing
        #
        if (self.state()):
            self.off()
            self.on()
        else:
            self.on()
            self.off()

    def __init__(self, name, relay):
        self.name = name

        logging.info(f"{self.name} relay hardware initializing: GPIO pins {relay_pin} (coil) and {sense_pin} (sense)")

        self.coil  = OutputDevice(relay[0], initial_value=False)
        self.sense = InputDevice(relay[1], pull_up=True)

        sleep(RELAY_SETTLE)
        if (self.state()):
            text = f"{self.name} relay was not OFF after initialization"
            logging.critical(text)
            EMERGENCY_STOP(text)

