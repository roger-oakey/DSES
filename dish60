class ENCODER_NR25:
    #
    # Advanced Micro Controls, Inc. NR25 Networked Resolver
    # file:///O:/DSES/DishDrive/MyDrive/NR25-ethernet-rotary-encoder_-_0D094.pdf
    #
    # Single revolution, 65536 steps.
    #
    # Modbus 16 bit registers read:
    #   0/1 32 bit scaled value
    #   2/3 32 bit velocity data
    #   4/5 32 bit raw position value
    #   6/7 32 bit time stamp data (400ns ticks since power on, rolls over every
    #                               28 minutes))
    #
    def _steps(self):

        #
        # Try reading the encoder 5 times before giving up
        #
        for i in range(5):
            #
            # Read 1 holding register starting at address 0 (slave/unit ID defaults to 1)
            #
            try:
                result = self.encoder.read_holding_registers(address=0, count=8)

                if (not result.isError()):
                    #
                    # Successful read, return steps. Steps (0-65535) is 16 bit
                    # word at offset 4. Chanage to an int (32 bits)
                    #
                    return(int(result.registers[4]))
                
                logging.error(f"{self.name} encoder, Modbus read error occurred: {result}")
                
            except Exception as e:
                logging.exception(f"{self.name} encoder, network connection exception: {e}")

        #
        # Stop everything and set flag to abort all threads
        #
        text = f"{self.name} encoder, unable to read encoder"
        logging.critical(text)
        EMERGENCY_STOP(text)

        #
        # Return 0 angle
        #
        return(65536 - self.correction)

    def _adjusted_steps(self):
        #
        # Add the correction to the steps read, then modulo the number of steps
        # to keep it in the 0-65535 range.
        #
        return((self._steps() + self.correction) % ENCODER_N25_STEPS)

    def position(self):
        #
        # Convert the steps to an angle. Multiply the steps by 360.0 first to
        # make the division more accurate.
        #
        return ((self._adjusted_steps() * 360.0) / ENCODER_N25_STEPS)
    
    def __init__(self, name, ip_addr, port, correction):
        self.name = name
        self.ip_addr = ip_addr
        self.port = port
        self.correction = correction

        logging.info(f"{self.name} encoder hardware initializing: IP {self.ip_addr}, port {self.port} correction {self.correction}")

        #Open a modbus connection to the encoder
        self.encoder = ModbusTcpClient(host=self.ip_addr, port=self.port)
        if (not self.encoder.connect()):
            #
            # Stop everything and set flag to abort all threads
            #
            text = f"{self.name} encoder, connection to {self.ip_addr}, {self.port} failed"
            logging.critical(text)
            EMERGENCY_STOP(text)

class AzimuthEncoder():

    def __ambiguous_zone(self, degrees):
        #
        # This will determine if you're in the ambigious zone
        #
        # See if currently in ambiguous zone
        if (degrees >= ENCODER_N25_ZONE_MAX):
            return (1)
        if (degrees <= ENCODER_N25_ZONE_MIN):
            return(-1)
        return(0)

    def __get_ambiguous(self):
        #
        # This will read the ambiguous file that has the value -1, 0 or 1 in it
        # to save the ambiguous state when shut down. It will also set
        # self.ambiguous to the current value.
        #
        try:
            with open(self.ambiguous_filename, "r", encoding="utf-8") as file:
                self.ambiguous = int(file.read())
                return

        except Exception as e:
            logging.exception(f'Exception when trying to read "{self.ambiguous_filename}", {e}')
            text = f'Unable to read "{self.ambiguous_filename}"'
            logging.critical(text)
            EMERGENCY_STOP(text)
            self.ambiguous = 0

    def __put_ambiguous(self, zone):
        #
        # This will write the ambiguous file with the value of -1, 0 or 1
        # depending on what zone you're in. It will also set self.ambiguous
        # to the current value.
        try:
            with open(self.ambiguous_filename, "w", encoding="utf-8") as file:
                file.write(f'{zone}')
                self.ambiguous = zone
                return

        except Exception as e:
            logging.exception(f'Exception when trying to write "{self.ambiguous_filename}", {e}')
            text = f'Unable to write "{self.ambiguous_filename}"'
            logging.critical(text)
            EMERGENCY_STOP(text)
            self.ambiguous = 0

    def __not_ambiguous(self):
        #
        # Save to the ambiguous file that we're not in the ambiguous zone.
        #
        self.__put_ambiguous(0)

    def position(self):

        # Get the position using the Encoder position method
        pos = self.encoder.position()

        # The ambiguous logic is basically edge-triggered. It detects the
        # transition from the non-ambiguous zone into the ambiguous zone and
        # "stays" in that zone until it transitions back into the non-ambiguous
        # zone.
        # 
        # If the heading is going up, going beyond a heading of 360 will cause
        # the heading to continue to climb until it hits the soft stop of 380
        # degrees (and for the 60 foot dish, it should hard stop before that).
        # 
        # If the heading is going down, going beyond a heading of 0 will cause
        # the heading to go negative, until it hits the soft stop of -20
        # degrees (and for the 60 foot dish, it should hard stop before that).

        if (self.ambiguous > 0):
            # We entered the ambiguous zone by going up in heading (positive/CW/
            # left), so if the encoder gives us degrees less than 180, we're
            # beyond North (heading 0), so add 360 to the current heading. We'll
            # be stopped at 15 degrees beyond North (heading 375).
            if (pos < 180.0):
                pos += 360.0

            # Now see if we've transitioned OUT of the ambiguous zone. If we're
            # anywhere (+ or -) in the ambiguous zone, just keep the current
            # ambiguous information. Otherwise if we've transitioned out of it,
            # set ambiguous to 0.
            if (not self.__ambiguous_zone(pos)):
                self.__not_ambiguous()

        elif (self.ambiguous < 0):
            # We entered the ambiguous zone by going down in heading
            # (negative/CCW/right), so if the encoder gives us degrees more than
            # 180, we're beyond North (heading 0), so subtract 360 from the
            # current heading. We'll be stopped at -15 degrees beyond North
            # (heading 345).
            if (pos > 180.0):
                pos -= 360.0

            # See if we've transitioned OUT of the ambiguous zone. If we're
            # anywhere (+ or -) in the ambiguous zone, just keep the current
            # ambiguous information. Otherwise if we've transitioned out of it,
            # set ambiguous to 0.
            if (not self.__ambiguous_zone(pos)):
                self.__not_ambiguous()

        else:
            # We were NOT in the ambiguous zone. Determine if we have
            # transitioned into it by seeing if the current position is IN the
            # ambiguous zone (1 or -1, both True). If so, save it.
            new_ambiguous = self.__ambiguous_zone(pos)
            if (new_ambiguous):
                self.__put_ambiguous(new_ambiguous)
        
        return(pos)
        
    def __init__(self, encoder):
        self.encoder = encoder
        self.name = self.encoder.name
        self.ambiguous_filename = FILE_NAME + ".ambiguous"

        logging.info(f"{self.name}Encoder class initializing: Ambiguous filename {self.ambiguous_filename}")

        #
        # Restore ambiguous state if necessary. Get the current position. If
        # it's witihin the ambiguous zone, restore the state of the ambiguous
        # zone.
        #
        # REad the current position
        #
        amb = self.__ambiguous_zone(self.encoder.position())
        if (amb):
            #
            # The current position puts us in the ambiguous zone. Read the
            # ambiguous file and see whch side of the zone we're really in.

            self.__get_ambiguous() # Call sets "self.ambigious"

            if (not self.ambiguous):
                #
                # According to the file, we not supposed to be in the ambiguous
                # zone. This is bad becasue we don't know which direction we
                # came from to get here!
                #
                text = f"""We're in the ambiguous zone, but the saved value says we aren't.
Ambiguous value: {self.ambiguous}, azimuth position: {self.encoder.position()}"""
                logging.critical(text)
                EMERGENCY_STOP(text)
        else:
            #
            # We're outside the ambiguous zone, force the ambiguous value to
            # zero no matter what.
            #
            self.__not_ambiguous()

class ElevationEncoder():

    def position(self):

        pos = self.encoder.position()

        if (pos > 225.0):
            #
            # Pointing below horizontal is negative
            #
            pos -= 360.0

