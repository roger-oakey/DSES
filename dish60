def azNum(azimuth):
    global AZqueue, AZmotor
    
    azimuth = float(azimuth)
    if (azimuth < AZIMUTH_MINIMUM):
        return("Error: Minimum azimuth is {AZIMUTH_MINIMUM}")
    if (azimuth > AZIMUTH_MAXIMUM):
        return("Error: Maximum azimuth is {AZIMUTH_MAXIMUM}")

    #
