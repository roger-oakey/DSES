class Encoder():

    def get_position(self):
        #
        # Actual call that hits the encoder to determine the current position
        # of the antenna. This call is broken out so we can use position() to
        # return the previously fetched position and avoid banging on the
        # encoders quite so much.
        #
        # Save where we were
        #
        self.last_position = self.current_position

        #
        # Now get where we are
        #
        self.current_position = self.encoder.position()

        #
        # Make sure we haven't gone out-of-bounds in either direction!
        #
        if (self.current_position > self.maxExcursion):
            text = f"{self.name} exceeded maxiumm excursion of {self.maximum} ({self.last_position})"
            logging.critical(text)
            EMERGENCY_STOP(text)

        if (self.current_position < self.minExcursion):
            text = f"{self.name} exceeded minimum excursion of {self.minimum} ({self.last_position})"
            logging.critical(text)
            EMERGENCY_STOP(text)

        #
        # Return the current position in case we want to skip a subsequent
        # positin() call.
        #
        return(self.current_position)

    def position(self):
        #
        # The call to get_position sets up the value of current_position which
        # we return from a position call. This is to keep network access to the
        # encoders down to a dull roar.
        #
        # Just make sure you call get_position (if necessary) before actually
        # calling position to refresh the position!
        #
        return(self.current_position)
    
    def progress(self):
        #
        # The call to progress is the only time we really interrogate the
        # encoder. All calls after this to "position" only return the value
        # determined when progress was called. This is to keep the encoders
        # from being swamped with network calls.
        #
        return(sign(self.current_position -  self.last_position))

    def __init__(self, encoder, min, max, excursion):
        self.encoder = encoder
        self.name = self.encoder.name

        self.maximum = max
        self.minimum = min
        self.maxExcursion = self.maximum + excursion
        self.minExcursion = self.minimum - excursion
        
        logging.info(f"Encoder class for {self.name} initializing: Min {self.minimum}, max {self.maximum}" excursion {excursion})

        #
        # Get initial position
        #
        self._position()

