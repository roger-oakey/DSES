class DAC_GP8630N:
    #
    # DAC control for the gravity GP8630N
    # https://www.dfrobot.com/product-3074.html
    #

    def voltage(self, volts):

        if (volts == self.last_volts):
            #
            # If no need to change voltage, don't.
            #
            return
        
        self.last_volts = volts

        if (volts >= 0):
            opcode = GP8630N_OPCODE_PLUS10V
        else:
            opcode = GP8630N_OPCODE_MINUS10V

        logging.info(f"{self.name} DAC setting voltage to {volts}")

        volts = abs(volts)

        if (volts > GP8630N_MAX_VOLTAGE):
            text = f"""Volts out of range for {self.name} DAC
Volts specified {volts}, volts maximum is {GP8630N_MAX_VOLTAGE}"""
            logging.critical(text)
            EMERGENCY_STOP(text)
            return

        steps = int(((volts / GP8630N_MAX_VOLTAGE) * GP8630N_MAX_STEPS) + 0.5)

        #
        # Open and close the I2C bus because more than one device is talking on
        # it. Take out a lock while doing this so two thread/processes aren't
        # trying to talk on the I2C bus at the same time.
        #
        try:
            with self.i2c_lock:
                bus = SMBus(1)
                bus.write_byte_data(self.address, 0, GP8630N_PREAMBLE)
                bus.write_byte_data(self.address, 1, opcode)
                bus.write_word_data(self.address, 2, steps)
                bus.close()
        except Exception as e:
            text = f"{self.name} DAC I2C communication exception: {e}"
            logging.exception(text)
            EMERGENCY_STOP(text)


    def __init__(self, name, address, i2c_lock):
        self.name = name
        self.address = address
        self.i2c_lock = i2c_lock

        logging.info(f"{self.name} DAC hardware initializing: I2C address 0x{address:x}")

        # Set DAC to zero voltage (a known state) to begin with
        self.last_volts = None
        self.voltage(0)

def sign(value):
    #
    # Return sign of number in the form of -1, 0 or 1
    #
    if (value > 0):
        return(1)

    if (value < 0):
        return(-1)
    
    return(0)

def reverse(old_speed, new_speed):
    if (not old_speed):
        #
        # Old speed is zero, so we're not changing directions
        #
        return (False)
    
    #
    # If signs of old speed and new speed are different, we're reversing.
    #
    return (sign(old_speed) != sign(new_speed))

